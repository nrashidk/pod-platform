# Neon PostgreSQL connection strings.
# Copy to `.env` and fill in your Neon project credentials.

# Pooled connection (PgBouncer) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true"

# Direct (non-pooled) connection — used by Prisma Migrate / introspection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Better Auth (back-office authentication).
# BETTER_AUTH_SECRET: a high-entropy random string used to sign sessions/cookies.
#   Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BETTER_AUTH_URL:   the origin the app is served from (deploy URL in production).
BETTER_AUTH_SECRET="generate-a-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Stripe — merchant wallet top-ups (money-in rail). TEST MODE for development.
# Live keys + a registered live webhook endpoint are a pre-production task
# (see PRE-PRODUCTION.md). The platform never holds BUYER funds — this is the
# merchant→platform prepaid wallet rail only.
# STRIPE_SECRET_KEY:     server-side API key. Use the test key (sk_test_…) in dev.
# STRIPE_WEBHOOK_SECRET: signing secret for /api/webhooks/stripe (whsec_…); the
#   webhook is the ONLY thing that credits a wallet, so its signature is the
#   money-in security boundary. Get it from the Stripe CLI (`stripe listen`) or
#   the Dashboard webhook endpoint.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Public origin used to build Stripe Checkout success/cancel return URLs. In
# Codespaces this is the forwarded HTTPS origin; in production the real domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
