// POD Platform — Prisma schema.
//
// Foundation layer: catalog + PrinterCapability matrix + routing inputs.
// The order/fulfillment layer (Order, OrderLine, Fulfillment, Shipment,
// Design, Merchant, StoreConnection, Wallet) is a later schema layer.
// Bilingual EN/AR is mandatory — every human-facing label carries _en and _ar.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) connection
  directUrl = env("DIRECT_URL")   // direct connection for migrations
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum PrintMethod {
  DTG          // direct-to-garment
  DTF          // direct-to-film
  SUBLIMATION
  EMBROIDERY   // requires digitization step
  UV           // hard goods (mugs, phone cases)
  SCREEN       // screen printing (bulk apparel)
  PAPER_PRINT  // cards, posters, stationery
}

enum ProductCategory {
  APPAREL
  DRINKWARE
  PAPER
  ACCESSORIES
  HOME
}

enum PrinterStatus {
  ACTIVE
  PAUSED      // temporarily out of routing (e.g. over capacity, holiday)
  REMOVED     // dropped from network (e.g. refused to honor a defect)
}

enum PlacementCode {
  FRONT
  BACK
  LEFT_SLEEVE
  RIGHT_SLEEVE
  WRAP        // mugs, bottles
  FULL        // all-over / single-face full print
}

// ─────────────────────────────────────────────────────────────
// CATALOG SIDE — what the buyer can order
// ─────────────────────────────────────────────────────────────

// A product type is the abstract item (t-shirt, mug, business card).
// It owns its print areas + file specs because those are intrinsic to the
// product, not to whichever printer fulfills it.
model ProductType {
  id        String          @id @default(cuid())
  slug      String          @unique
  name_en   String
  name_ar   String
  category  ProductCategory

  printAreas   PrintArea[]
  products     Product[]
  capabilities PrinterCapability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A printable region on a product type, with its production file spec.
// e.g. t-shirt FRONT @ 12x16in / 150 DPI; mug WRAP @ 8x3in / 300 DPI.
model PrintArea {
  id            String      @id @default(cuid())
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  productTypeId String
  placement     PlacementCode

  // Production file spec (the "print file", NOT the mockup).
  width_mm      Float       // actual print dimensions
  height_mm     Float
  min_dpi       Int         @default(150)
  recommended_dpi Int       @default(300)
  allowed_formats String[]  @default(["PNG", "JPEG"])
  color_profile String      @default("sRGB")
  requires_transparency Boolean @default(false) // true for DTG on dark garments
  bleed_mm      Float       @default(0)
  max_file_mb   Int         @default(200)

  @@unique([productTypeId, placement])
}

// A concrete catalog item the buyer sees (a specific styled product the
// platform lists). Listable only if >=1 ACTIVE capability exists for its type.
model Product {
  id            String      @id @default(cuid())
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  productTypeId String
  name_en       String
  name_ar       String
  description_en String?
  description_ar String?
  retail_price  Decimal     @db.Decimal(10, 2)   // store-set; spread lives above wholesale
  active        Boolean     @default(true)

  variants      ProductVariant[]
  orderLines    OrderLine[]      // order layer: lines ordering this product

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Size x color (etc.) of a product.
model ProductVariant {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  sku       String  @unique
  size      String?
  color     String?
  active    Boolean @default(true)

  orderLines OrderLine[]         // order layer: lines ordering this variant

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// SUPPLY SIDE — printers and the capability matrix
// ─────────────────────────────────────────────────────────────

model Printer {
  id        String        @id @default(cuid())
  name      String
  status    PrinterStatus @default(ACTIVE)

  // Location — for proximity tiebreaker in routing (weak factor within UAE,
  // gains weight GCC-wide).
  emirate   String?
  country   String        @default("AE")
  latitude  Float?
  longitude Float?

  // Hard gate before any routing: no blind-ship confirmation = no orders.
  blind_ship_confirmed Boolean @default(false)
  return_address String?

  // Contract / protection flags (mirror §5b of the model spec).
  contract_signed      Boolean @default(false)
  accepts_bulk_holdback Boolean @default(false) // 70/30 retention agreed in writing

  // Capacity signal — drives the capacity HARD GATE in routing.
  // A printer at/over capacity drops out of eligibility entirely.
  daily_capacity_units Int?    // max units/day this printer can take
  current_load_units   Int     @default(0) // updated as orders are assigned
  // Derived eligibility: ACTIVE && blind_ship_confirmed && load < capacity.

  // Quality score — feeds routing once defect data exists (low defect rate
  // should outrank pure cost: a cheap high-defect printer is a false economy).
  quality_score Float? // 0..1, nullable until data accrues

  payout_terms String? // free-text for now (e.g. "upfront full <1000 AED; 70/30 bulk")

  capabilities PrinterCapability[]
  fulfillments Fulfillment[]      // order layer: fulfillments routed to this printer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// THE LOAD-BEARING TABLE.
// One row per (printer x product type x print method) the printer can do.
// This single table answers three questions at once:
//   1. ROUTING  — which printers are eligible for a given order line.
//   2. CATALOG  — a product type is listable iff >=1 ACTIVE row exists.
//   3. COST     — the wholesale cost used for the cost-primary routing rank.
// Print SPEC is NOT here — it lives on PrintArea (intrinsic to product+method).
model PrinterCapability {
  id            String      @id @default(cuid())
  printer       Printer     @relation(fields: [printerId], references: [id], onDelete: Cascade)
  printerId     String
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  productTypeId String
  method        PrintMethod

  // Routing inputs (printer-specific economics).
  unit_wholesale_cost Decimal @db.Decimal(10, 2)  // base; tiers below may override
  min_qty       Int     @default(1)
  max_qty       Int?                              // null = no cap
  active        Boolean @default(true)

  // EMBROIDERY (and similar) need a digitization step in the order lifecycle.
  requires_digitization Boolean @default(false)

  // Optional per-capability spec override. Normally null — spec comes from
  // PrintArea. Populate ONLY if a specific printer needs a different spec for
  // the same product (rare).
  spec_override Json?

  // Volume pricing (optional in v1). If present, overrides unit_wholesale_cost
  // at/above the tier's min_qty.
  pricingTiers  PricingTier[]
  fulfillments  Fulfillment[]   // order layer: fulfillments using this capability

  // A printer can do a product type via multiple methods, but each
  // (printer, productType, method) combination is unique.
  @@unique([printerId, productTypeId, method])
  @@index([productTypeId, method, active]) // routing lookup: eligible printers
}

// Volume price breaks for a capability (e.g. 25+ units at a lower unit cost).
// Relevant to the order-1-then-bulk pattern.
model PricingTier {
  id           String            @id @default(cuid())
  capability   PrinterCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  capabilityId String
  min_qty      Int                                  // tier applies at this qty and up
  unit_cost    Decimal           @db.Decimal(10, 2)

  @@unique([capabilityId, min_qty])
  @@index([capabilityId])
}

// ═════════════════════════════════════════════════════════════
// ORDER / FULFILLMENT / DESIGN / WALLET LAYER (build step 4)
//
// Builds on the foundation models above. Reflects
// /docs/pod-platform-data-model.md and /docs/schema-orders.prisma:
//  - Pure Printful money model (Reading B): platform never holds buyer funds.
//  - Own store = "merchant zero" (a Merchant record), so one money path.
//  - Order splits across printers; Fulfillment = unit of liability/shipping/claims.
//  - Order.status is DERIVED from Fulfillment statuses (aggregate, display-only).
//  - Two-file pipeline: mockup (preview) vs print file (validated per placement).
//  - 70/30 retention on bulk (Fulfillment wholesale_cost >= AED 1000), released
//    on delivery + closed claim window. Netting + removal discipline.
// ═════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────
// ORDER-LAYER ENUMS
// ─────────────────────────────────────────────────────────────

enum OrderOrigination {
  OWN_STORE       // platform owner's own storefront (merchant zero)
  CONNECTED_STORE // an external merchant's store (Shopify/Salla/Zid/Woo)
}

// DERIVED aggregate of the order's Fulfillment statuses. For display only —
// never the source of truth. Compute from fulfillments.
enum OrderStatus {
  DRAFT
  AWAITING_APPROVAL // mockup not yet locked
  APPROVED          // mockup locked + all print files validated
  PAID
  ROUTED
  IN_PRODUCTION
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  CLOSED
  CANCELLED
}

enum FulfillmentStatus {
  PENDING_ROUTING
  ROUTED                 // printer assigned
  FIRST_ARTICLE_PENDING  // bulk: proof unit awaiting approval
  FIRST_ARTICLE_APPROVED // bulk: full run cleared to proceed
  IN_PRODUCTION
  DIGITIZING             // embroidery digitization step
  SHIPPED
  DELIVERED
  CLOSED                 // claim window passed, retention settled
  REROUTED               // printer couldn't fulfill; moved to another
  CANCELLED
}

enum DesignValidationStatus {
  PENDING
  PASSED
  FLAGGED   // print file failed spec (low DPI, wrong format, etc.)
}

// 70/30 retention state on a (bulk) Fulfillment.
enum HoldStatus {
  NONE              // sub-threshold order: paid in full, no hold
  HELD              // 30% withheld, awaiting release event
  RELEASED          // delivery + claim window closed, no claim → printer paid
  DEDUCTED          // defect: cost taken from hold
  PARTIALLY_DEDUCTED
}

enum ClaimStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESOLVED
}

enum LiabilityParty {
  PRINTER
  BUYER
  CARRIER
  PLATFORM
}

enum StorePlatform {
  OWN
  SHOPIFY
  SALLA
  ZID
  WOOCOMMERCE
}

enum WalletTxnType {
  TOPUP
  FULFILLMENT_CHARGE
  REFUND
  ADJUSTMENT
}

// ─────────────────────────────────────────────────────────────
// MERCHANT / STORE / WALLET  (the merchant→platform money rail)
// ─────────────────────────────────────────────────────────────

// A store owner billed for fulfillment. The platform owner's own store is
// ALSO a Merchant record ("merchant zero") — keeps one money path under
// Reading B. Merchants never hand the platform the BUYER's money; they fund a
// wallet that the platform charges for fulfillment + margin.
model Merchant {
  id            String   @id @default(cuid())
  name          String
  is_platform_owner Boolean @default(false) // true for "merchant zero"
  email         String   @unique
  vat_trn       String?  // UAE VAT registration (InvoLinks territory)

  // White-label brand assets applied to this merchant's parcels.
  brand_logo_url      String?
  packing_slip_message String?
  return_address      String?
  custom_packaging_note String?

  wallet        Wallet?
  stores        StoreConnection[]
  orders        Order[]
  designs       Design[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  id            String   @id @default(cuid())
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId    String   @unique
  balance       Decimal  @db.Decimal(12, 2) @default(0)
  currency      String   @default("AED")

  // Auto-recharge (Printful wallet model): top up when balance < threshold.
  auto_recharge_enabled Boolean @default(false)
  auto_recharge_threshold Decimal? @db.Decimal(12, 2)
  auto_recharge_amount    Decimal? @db.Decimal(12, 2)

  transactions  WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id          String        @id @default(cuid())
  wallet      Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletId    String
  type        WalletTxnType
  amount      Decimal       @db.Decimal(12, 2) // + credit, - debit
  balance_after Decimal     @db.Decimal(12, 2)
  orderId     String?       // set for FULFILLMENT_CHARGE / REFUND
  note        String?
  createdAt   DateTime      @default(now())

  @@index([walletId, createdAt])
}

// An external store connected to the platform. Interchangeable adapter — core
// never cares which platform. v1 = OWN; v1.1 = SHOPIFY; v1.2+ = SALLA, ZID.
model StoreConnection {
  id          String        @id @default(cuid())
  merchant    Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId  String
  platform    StorePlatform
  store_name  String
  // Adapter credentials/tokens — store encrypted; shape varies per platform.
  credentials Json?
  webhook_secret String?
  active      Boolean       @default(true)
  orders      Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId, platform])
}

// ─────────────────────────────────────────────────────────────
// DESIGN  (the two-file pipeline: mockup vs print file)
// ─────────────────────────────────────────────────────────────

// A reusable design. The MOCKUP is the buyer-approved preview. The PRINT FILES
// live per placement (one design can print on FRONT + BACK = two files).
// A design can be applied across multiple products/orders.
model Design {
  id            String   @id @default(cuid())
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  merchantId    String
  name          String

  // Mockup preview (reference only — NOT production).
  mockup_url    String?

  // Buyer approval = the contract on design intent (timestamped lock).
  mockup_approved_at DateTime?

  placements    DesignPlacement[]
  orderLines    OrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
}

// One print file per placement on a design, each independently spec-validated
// against the corresponding PrintArea.
model DesignPlacement {
  id          String        @id @default(cuid())
  design      Design        @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId    String
  placement   PlacementCode

  print_file_url String
  // Validation against the product type's PrintArea spec (DPI/format/dims).
  validation_status DesignValidationStatus @default(PENDING)
  validation_notes  String?
  // Embroidery: digitized stitch file produced after order; preview is more
  // accurate than the mockup.
  digitized_file_url String?

  @@unique([designId, placement])
}

// ─────────────────────────────────────────────────────────────
// ORDER / FULFILLMENT / SHIPMENT
// ─────────────────────────────────────────────────────────────

model Order {
  id            String           @id @default(cuid())
  origination   OrderOrigination
  merchant      Merchant         @relation(fields: [merchantId], references: [id])
  merchantId    String
  store         StoreConnection? @relation(fields: [storeId], references: [id])
  storeId       String?
  external_order_ref String?     // the connected platform's order id

  // DERIVED display status (compute from fulfillments — not authoritative).
  status        OrderStatus      @default(DRAFT)

  // Recipient (end buyer). End buyers may not have accounts; store shipping
  // info directly. Brand shown to them = the merchant's (branding_source).
  recipient_name String
  recipient_phone String?
  shipping_line1 String
  shipping_line2 String?
  shipping_city  String
  shipping_emirate String?
  shipping_country String         @default("AE")

  // Money (retail collected by the STORE's gateway — platform never holds it).
  retail_total  Decimal          @db.Decimal(12, 2)
  currency      String           @default("AED")
  paid_at       DateTime?        // store gateway confirmed buyer payment

  lines         OrderLine[]
  fulfillments  Fulfillment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId, createdAt])
  @@index([storeId])
}

model OrderLine {
  id          String         @id @default(cuid())
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product        @relation(fields: [productId], references: [id])
  productId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  variantId   String
  design      Design         @relation(fields: [designId], references: [id])
  designId    String
  method      PrintMethod    // required capability (with product type) for routing
  quantity    Int
  unit_retail Decimal        @db.Decimal(10, 2)

  // Assigned during routing. Lines needing the same capability group onto one
  // Fulfillment; different capabilities split to different printers.
  fulfillment   Fulfillment? @relation(fields: [fulfillmentId], references: [id])
  fulfillmentId String?

  @@index([orderId])
  @@index([fulfillmentId])
}

// One per printer the order is split to. THE UNIT OF LIABILITY, SHIPPING,
// CLAIMS, and the 70/30 retention.
model Fulfillment {
  id          String            @id @default(cuid())
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  printer     Printer           @relation(fields: [printerId], references: [id])
  printerId   String
  capability  PrinterCapability? @relation(fields: [capabilityId], references: [id])
  capabilityId String?
  status      FulfillmentStatus @default(PENDING_ROUTING)

  lines       OrderLine[]
  shipments   Shipment[]

  // Costs.
  wholesale_cost Decimal        @db.Decimal(12, 2) // what platform owes printer

  // Estimated delivery shown at checkout = production_lead + shipping_time.
  estimated_delivery_days Int?

  // ── Bulk retention (70/30). Bulk = wholesale_cost >= 1000 AED. ──
  is_bulk          Boolean      @default(false)
  hold_status      HoldStatus   @default(NONE)
  dispatch_paid    Decimal?     @db.Decimal(12, 2) // 70% paid on dispatch
  held_amount      Decimal?     @db.Decimal(12, 2) // 30% withheld
  hold_release_at  DateTime?    // SET when release EVENT fires (delivery + claim window closed)

  // ── First-article approval (mandatory on bulk). ──
  first_article_required Boolean @default(false)
  first_article_approved_at DateTime?

  claims      DefectClaim[]
  payments    PrinterPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([printerId, status])
}

model Shipment {
  id            String       @id @default(cuid())
  fulfillment   Fulfillment  @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  fulfillmentId String
  carrier       String?
  tracking_number String?

  // White-label: merchant brand only. No printer/platform branding.
  packing_slip_brand String?   // resolved from merchant.brand_* at ship time

  // Proof of delivery STARTS the defect-claim window (not ship date).
  proof_of_delivery_url String?
  delivered_at  DateTime?
  claim_window_closes_at DateTime? // delivered_at + 30 days

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fulfillmentId])
}

// ─────────────────────────────────────────────────────────────
// DEFECTS / PRINTER MONEY (the platform→printer rail + protection)
// ─────────────────────────────────────────────────────────────

model DefectClaim {
  id            String       @id @default(cuid())
  fulfillment   Fulfillment  @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  fulfillmentId String
  status        ClaimStatus  @default(OPEN)
  liable_party  LiabilityParty?

  description   String
  photo_urls    String[]     // mandatory photo proof (Vercel Blob)

  // Resolution.
  resolution_note String?
  refund_amount  Decimal?    @db.Decimal(12, 2)
  reprint_ordered Boolean    @default(false)
  // If printer-liable: cost recovered from held_amount, else netted (ledger).
  recovered_from_hold Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fulfillmentId, status])
}

// Actual transfers from platform to a printer for a fulfillment (70% dispatch,
// 30% release).
model PrinterPayment {
  id            String      @id @default(cuid())
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  fulfillmentId String
  amount        Decimal     @db.Decimal(12, 2)
  kind          String      // "DISPATCH_70" | "RELEASE_30" | "FULL" | "ADJUSTMENT"
  paid_at       DateTime?
  createdAt     DateTime    @default(now())

  @@index([fulfillmentId])
}

// Running-account netting: unrecovered defect costs credited against a
// printer's future orders. A printer-level ledger of debits/credits.
model PrinterLedgerEntry {
  id          String   @id @default(cuid())
  printerId   String
  amount      Decimal  @db.Decimal(12, 2) // + owed to printer, - owed by printer (defect)
  reason      String
  fulfillmentId String?
  settled     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([printerId, settled])
}
